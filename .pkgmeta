# Read by CurseForge's automatic packaging (the repository webhook). The addon lives in the
# PandaQuest/ subfolder, so the folder is moved up and everything else in the root is left out;
# without this the package would be the whole repository inside a PandaQuest/ folder.
#
# The GitHub release zip (build.py) is the reference package. This one is made by CurseForge's
# packager, which does not run build.py: the TOCs keep their declared "## Version: 0.2.0" and there
# is no Core/Build.lua, so /pq status shows 0.2.0 in a package that came from here.
# markup-type is left out: CurseForge's validator rejects "text" ("Unknown markup type 'text'"),
# and the packager reads a .txt file as plain text without being told.
#
# Every game's TOC is committed in PandaQuest/ (build.py tocs writes them from the template), so this
# package carries all four games like the release zip: PandaQuest.toc + _Mists (Mists of Pandaria
# Classic), _Vanilla (Classic Era), _TBC (TBC Anniversary), _Forever + _Camelot (WoW Forever), each
# listing only its own database. The packager tags the file with a game version per TOC it
# recognises; README.md, "The CurseForge webhook package", says which suffixes those are.
package-as: PandaQuest
manual-changelog:
  filename: PandaQuest/changelog.txt
move-folders:
  PandaQuest/PandaQuest: PandaQuest
ignore:
  - .github
  - assets
  - README.md
  - LICENSE
  - data-sync.json
